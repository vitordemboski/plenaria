# deps / build
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# dados gerados (reproduzíveis via `npm run data` / `npm run data:real`)
data/*.json
# EXCEÇÃO: as análises escritas por IA NÃO são reproduzíveis pelo pipeline — elas
# custam geração e revisão humana, e o `data:real` só as LÊ (para logar quantas
# ficaram obsoletas). Perder este arquivo é perder trabalho, como o social.csv.
!data/analises.json
public/data/*.json
# proposições por parlamentar (~584 arquivos, ~11MB) — servidas sob demanda no clique
# do tema; reproduzíveis por `npm run data:real`, como todo o resto de public/data/
public/data/props/
# fotos oficiais baixadas dos portais (reproduzíveis via `npm run fotos`, ~10MB)
public/fotos/
# cards de compartilhamento por parlamentar (reproduzíveis via `npm run og`, ~39MB).
# A barra final é essencial: sem ela isto casaria também `public/og.jpg`, que é o
# card do site e É versionado.
public/og/
# cache de downloads dos Dados Abertos (~750MB) — reproduzível por `npm run data:real`.
# Note o `/*` em vez de `data/raw/`: com a barra final o git nem entra no diretório,
# e qualquer exceção futura (`!data/raw/algo.csv`) seria ignorada em silêncio.
data/raw/*

# `data/social.csv` NÃO está ignorado e é VERSIONADO de propósito: são os seguidores
# do Instagram coletados via Apify (serviço PAGO). É o único dado do projeto que
# nenhum script reproduz de graça — perdê-lo custa crédito.

# ambiente
.env*
!.env.example
# config pessoal de agente (permissões da máquina de cada um). Estava coberto só
# pelo gitignore GLOBAL do autor — que nenhum contribuidor tem.
.claude/settings.local.json
.DS_Store

# Local Netlify folder
.netlify

# Variáveis de ambiente da Plenária. Copie para `.env` e preencha o que precisar.
# NADA aqui é obrigatório para `npm run dev`/`build` — cada uma liga um extra.

# Cloudflare Web Analytics — token do beacon (cookieless, sem consentimento).
# É PÚBLICO por design: já vai no bundle do site. Sem ele, a tag de analytics
# nem é emitida (dev/preview ficam sem tracking). Como NEXT_PUBLIC_*, é inlinado
# no build. Obtenha em: Cloudflare Dashboard → Analytics & Logs → Web Analytics.
NEXT_PUBLIC_CF_BEACON_TOKEN=

# Apify — coleta de seguidores do Instagram (`npm run social:*`). SEGREDO,
# serviço PAGO: nunca commitar com valor. https://console.apify.com/account#/integrations
APIFY_TOKEN=
